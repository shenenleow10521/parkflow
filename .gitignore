# build output (regenerate with: node tools/build.mjs)
build/
dist/app.js
dist/driver.js
dist/test.html
dist/test-driver.html
node_modules/
__pycache__/
.DS_Store
.impeccable/
.codex-preview/
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
dist/assets/
dist/command.html
dist/driver.html
dist/test-landing.html

# simulation raw output (regenerate with: python analysis/simulate_zone_size.py)
analysis/*.npz
analysis/benchmark_data/

# submission: keep current PDF exports; HTML/PPTX intermediates stay local
submission/*.html
submission/*.pptx
~$*

# presentation review output
presentation/generated/
presentation/render/
presentation/*.pdf

# V2 embeds its SVG exhibits; standalone chart previews are regenerated.
site-consulting/assets/graphics-preview/
site-consulting/assets/v2-charts/
