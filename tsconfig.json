{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "build",
    "rootDir": "src",
    "removeComments": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
